<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════════════════════════════
             Account Fiscal Year — Tree View
        ════════════════════════════════════════ -->
        <record id="account_fiscal_year_tree_view" model="ir.ui.view">
            <field name="name">Tree view for account.fiscal.year</field>
            <field name="model">account.fiscal.year</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="company_id" groups="base.group_multi_company" />
                </tree>
            </field>
        </record>

        <!-- ════════════════════════════════════════
             Account Fiscal Year — Form View
        ════════════════════════════════════════ -->
        <record id="account_fiscal_year_form_view" model="ir.ui.view">
            <field name="name">Form view for account.fiscal.year</field>
            <field name="model">account.fiscal.year</field>
            <field name="arch" type="xml">
                <form string="Fiscal Year">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════
             Account Fiscal Year — Search View
        ════════════════════════════════════════ -->
        <record id="account_fiscal_year_search_view" model="ir.ui.view">
            <field name="name">account.fiscal.year.search</field>
            <field name="model">account.fiscal.year</field>
            <field name="arch" type="xml">
                <search string="Fiscal Year">
                    <field name="name" />
                    <field name="date_from" />
                    <field name="date_to" />
                    <filter string="Current Year"
                            name="current_year"
                            domain="[('date_from','&lt;=', context_today()),
                                     ('date_to','&gt;=', context_today())]" />
                </search>
            </field>
        </record>

        <!-- ════════════════════════════════════════
             Action Window
        ════════════════════════════════════════ -->
        <record id="action_account_fiscal_year" model="ir.actions.act_window">
            <field name="name">Fiscal Years</field>
            <field name="res_model">account.fiscal.year</field>
            <field name="view_mode">tree,form</field>
            <field name="view_type">form</field>
        </record>

        <!-- Menu item -->
        <menuitem id="menu_account_fiscal_year"
                  name="Fiscal Years"
                  parent="account.menu_finance_configuration"
                  action="action_account_fiscal_year"
                  sequence="15" />

    </data>
</odoo>
